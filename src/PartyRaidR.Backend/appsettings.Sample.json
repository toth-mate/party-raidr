{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YOUR_SECRET_API_KEY",
    "Issuer": "PartyRaidR.Backend",
    "Audiences": [ "PartyRaidR.Web", "PartyRaidR.Mobile" ],
    "DurationInMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Port=3306;Database=partyraidrdb;Uid=YOUR_USER_ID;Pwd=YOUR_PASSWORD;"
  }
}
