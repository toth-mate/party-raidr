<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:PartyRaidR.Mobile.ViewModels"
             xmlns:models="clr-namespace:PartyRaidR.Shared.Dtos;assembly=PartyRaidR.Shared"
             x:DataType="vm:BrowseEventsVM"
             x:Class="PartyRaidR.Mobile.Views.Pages.BrowseEventsPage">
    <Grid Padding="6,40,6,6" RowDefinitions="Auto, *">
        <Label Text="Events"
               VerticalOptions="Center" 
               HorizontalOptions="Center"
               Grid.Row="0"
               Style="{StaticResource SubHeadline}"/>
        <CollectionView ItemsSource="{Binding Events}"
                        Margin="0,8,0,0"
                        VerticalScrollBarVisibility="Always"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EventDisplayDto">
                    <Border Margin="0,7,0,0" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Padding="8">
                            <Label Text="{Binding Title}"
                                   TextColor="{StaticResource PrimaryDark}"
                                   FontSize="18"
                                   Margin="0,5"/>
                            <Label Text="{Binding Description}"
                                   TextColor="{StaticResource Gray400}"
                                   Margin="0,0,0,5"/>
                            <HorizontalStackLayout Margin="0,0,0,2">
                                <Label Text="Starts at: " TextColor="{StaticResource Gray600}"/>
                                <Label Text="{Binding StartingDate}" TextColor="{StaticResource Gray500}"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout>
                                <Label Text="Ends at: " TextColor="{StaticResource Gray600}"/>
                                <Label Text="{Binding EndingDate}" TextColor="{StaticResource Gray500}"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout>
                                <Label Text="At: " TextColor="{StaticResource Gray600}"/>
                                <Label Text="{Binding City}" TextColor="{StaticResource Secondary}"/>
                                <Label Text=", " TextColor="{StaticResource Secondary}"/>
                                <Label Text="{Binding PlaceName}" TextColor="{StaticResource Secondary}"/>
                            </HorizontalStackLayout>
                            <Button Text="Apply"
                                    FontSize="16"
                                    Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>