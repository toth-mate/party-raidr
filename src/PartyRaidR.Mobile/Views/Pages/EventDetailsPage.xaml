<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PartyRaidR.Mobile.ViewModels"
             x:DataType="vm:EventDetailsVM"
             x:Class="PartyRaidR.Mobile.Views.Pages.EventDetailsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout Grid.Row="0">
            <Label Text="{Binding Event.Title}"
                   Style="{StaticResource SubHeadline}"
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"/>
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Margin="0,2,0,0">
                <Label Text="By: " TextColor="{StaticResource Gray300}"/>
                <Label Text="{Binding Event.AuthorName}" TextColor="{StaticResource Gray300}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
